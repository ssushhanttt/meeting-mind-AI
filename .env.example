# ---------------------------------------------------------------------------
# MeetingMind environment configuration
# Copy this file to ".env" and fill in real values. Never commit the real .env
# ---------------------------------------------------------------------------

# --- LLM Provider (Cerebras) -------------------------------------------------
# If CEREBRAS_API_KEY is left blank, MeetingMind automatically runs in
# MOCK MODE: it still works end-to-end (summaries + action items) using a
# local heuristic engine, so the app never crashes from a missing key.
LLM_PROVIDER=cerebras
CEREBRAS_API_BASE=https://api.cerebras.ai/v1
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# --- Audio transcription (faster-whisper) -----------------------------------
# Model size options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
# device: cpu or cuda
WHISPER_DEVICE=cpu
# compute_type: int8 (fastest/lowest RAM on CPU), float16 (GPU), float32
WHISPER_COMPUTE_TYPE=int8

# --- Database ----------------------------------------------------------------
# SQLite file path (relative to project root, or absolute for Cloud Run
# ephemeral storage such as /tmp/meetingmind.db)
DATABASE_PATH=meetingmind.db

# --- App behaviour -------------------------------------------------------------
APP_ENV=local
MAX_UPLOAD_MB=200
